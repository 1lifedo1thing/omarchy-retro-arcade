# Build from a clean checkout with packaging/build-arch.sh.
pkgname=omarchy-chess
pkgver=0.2.0
pkgrel=1
pkgdesc='Native offline chess for Omarchy Arcade, written in Rust'
arch=('x86_64' 'aarch64')
url='https://github.com/tcballard/omarchy-chess'
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'glibc' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11' 'libglvnd' 'wayland' 'xdg-desktop-portal' 'libpulse')
optdepends=('xdg-desktop-portal-gtk: file chooser fallback')
makedepends=('rust>=1.98' 'pkgconf')
_engine_commit=59aae690f91d6f69aac194f447d84b4a2c3be778
source=('omarchy-chess-source.tar.gz'
        "stockfish-${_engine_commit}.tar.gz::https://codeload.github.com/official-stockfish/Stockfish/tar.gz/${_engine_commit}"
        'https://tests.stockfishchess.org/api/nn/nn-1a298aa575a0.nnue')
# Only the app snapshot checksum is filled by build-arch.sh.
sha256sums=('SKIP'
            '85bc210f6a4fc98759fbc1a6bfd8b5a25bed9dafa6d5959008c0dbe20fc7848d'
            '1a298aa575a085434d29027978dc36867fe9c5bcea9376654b7a8eba1e52dfc2')
prepare() {
  cp "$srcdir/nn-1a298aa575a0.nnue" "$srcdir/Stockfish-${_engine_commit}/src/"
  cd "$srcdir/omarchy-chess"
  cargo fetch --locked
}
build() {
  cd "$srcdir/Stockfish-${_engine_commit}/src"
  local engine_arch=x86-64
  [[ $CARCH != aarch64 ]] || engine_arch=armv8
  make -j2 build ARCH="$engine_arch" COMP=gcc
  cd "$srcdir/omarchy-chess"
  cargo build --frozen --release
}
check() {
  cd "$srcdir/omarchy-chess"
  OMARCHY_CHESS_ENGINE="$srcdir/Stockfish-${_engine_commit}/src/stockfish" REQUIRE_STOCKFISH=1 cargo test --frozen --all-targets
}
package() {
  install -Dm755 "$srcdir/Stockfish-${_engine_commit}/src/stockfish" "$pkgdir/usr/lib/omarchy-chess/stockfish"
  install -Dm644 "$srcdir/Stockfish-${_engine_commit}/Copying.txt" "$pkgdir/usr/share/licenses/$pkgname/Stockfish.txt"
  cd "$srcdir/omarchy-chess"
  install -Dm755 target/release/omarchy-chess "$pkgdir/usr/bin/omarchy-chess"
  install -Dm644 packaging/omarchy-chess.desktop "$pkgdir/usr/share/applications/omarchy-chess.desktop"
  install -Dm644 packaging/omarchy-chess.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omarchy-chess.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD_PARTY.md "$pkgdir/usr/share/doc/$pkgname/THIRD_PARTY.md"
}
