pkgname=omarchy-invaders
pkgver=0.1.0
pkgrel=1
pkgdesc='Native arcade shooter for Omarchy Arcade'
arch=('x86_64' 'aarch64')
url='https://github.com/tcballard/omarchy-invaders'
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'glibc' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11' 'libglvnd' 'wayland' 'libpulse')
makedepends=('rust' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')
prepare() { cd "$srcdir/$pkgname-$pkgver"; cargo fetch --locked; }
build() { cd "$srcdir/$pkgname-$pkgver"; cargo build --frozen --release; }
check() { cd "$srcdir/$pkgname-$pkgver"; cargo test --frozen; }
package() {
 cd "$srcdir/$pkgname-$pkgver"
 install -Dm755 target/release/omarchy-invaders "$pkgdir/usr/bin/omarchy-invaders"
 install -Dm644 packaging/omarchy-invaders.desktop "$pkgdir/usr/share/applications/omarchy-invaders.desktop"
 install -Dm644 packaging/omarchy-invaders.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omarchy-invaders.svg"
 install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
