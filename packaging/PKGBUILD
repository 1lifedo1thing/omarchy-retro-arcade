# Build from a checked-out source tree: ./packaging/build-arch.sh
pkgname=omarchy-chess
pkgver=0.1.0dev1
pkgrel=1
pkgdesc='Native offline chess for Omarchy, powered by Stockfish'
arch=('any')
url='https://github.com/tcballard/omarchy-chess'
license=('GPL-3.0-or-later')
depends=('python>=3.11' 'pyside6' 'qt6-svg' 'qt6-wayland' 'python-chess')
optdepends=('stockfish: computer opponent and hints')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-pytest')
source=('omarchy-chess-source.tar.gz')
# Generated local snapshot; build-arch.sh replaces this with its SHA256.
sha256sums=('SKIP')

build() {
  cd "$srcdir/omarchy-chess"
  python -m build --wheel --no-isolation
}

check() {
  cd "$srcdir/omarchy-chess"
  QT_QPA_PLATFORM=offscreen python -m pytest -q
}

package() {
  cd "$srcdir/omarchy-chess"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 packaging/omarchy-chess.desktop "$pkgdir/usr/share/applications/omarchy-chess.desktop"
  install -Dm644 packaging/omarchy-chess.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omarchy-chess.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD_PARTY.md "$pkgdir/usr/share/doc/$pkgname/THIRD_PARTY.md"
}
